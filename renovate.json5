{
  "extends": [
    "config:best-practices",
    ":pinDisabled"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": false
    },
    // only needed if this repo uses laravel nova
    {
      "matchManagers": ["composer"],
      "schedule": ["before 7am every weekday"],
      "registries": ["composer-nova"]
    }
  ],
  "registries": {
    // only needed if this repo uses laravel nova
    "composer-nova": {
      "type": "composer",
      "url": "https://nova.laravel.com",
      "username": "dan@prodigi.nz"
      // NOTE: env var RENOVATE_COMPOSER_NOVA_PASSWORD is passed in from COMPOSER_NOVA_PASSWORD, set in fj UI
      // for the renovate-bot user, under Settings | Actions | Secrets
    }
  },
  "osvVulnerabilityAlerts": true
}