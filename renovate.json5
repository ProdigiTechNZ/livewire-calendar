{
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      // major updates disabled — security vulnerabilities (osvVulnerabilityAlerts) will still raise PRs
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    // automerge policy is handled by global config (server/config.js):
    //   patch → always automerge
    //   minor → automerge dev deps only (require-dev / devDependencies)
    //   major → disabled
    // to override global policy for this repo, uncomment:
    // {
    //   "matchUpdateTypes": ["minor", "patch"],
    //   "automerge": true,
    //   "automergeType": "merge-commit"
    // },
    // only needed if this repo uses laravel nova — remove otherwise
    {
      "matchManagers": ["composer"],
      "matchPackagePatterns": ["laravel/nova"],
      "schedule": ["before 7am every weekday"]
    }
  ],
  "pinDigests": false,
  "osvVulnerabilityAlerts": true
}
